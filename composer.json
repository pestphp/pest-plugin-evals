{
    "name": "pestphp/pest-plugin-evals",
    "description": "A PestPHP plugin for evaluating Laravel AI SDK agents with LLM-as-judge, semantic similarity, and deterministic scorers",
    "keywords": [
        "php",
        "framework",
        "pest",
        "unit",
        "test",
        "testing",
        "plugin",
        "eval",
        "ai",
        "llm",
        "laravel"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Pushpak Chhajed",
            "email": "pushpak1300@gmail.com"
        },
        {
            "name": "Nuno Maduro",
            "email": "enunomaduro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "laravel/ai": "^0.8.1",
        "pestphp/pest": "^5.0.0",
        "pestphp/pest-plugin": "^5.0.0"
    },
    "require-dev": {
        "laravel/framework": "^13.19.0",
        "orchestra/testbench": "^11.1.0",
        "pestphp/pest-dev-tools": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "Pest\\Evals\\": "src/"
        },
        "files": [
            "src/Autoload.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pest\\Evals\\Tests\\": "tests/"
        }
    },
    "extra": {
        "pest": {
            "plugins": [
                "Pest\\Evals\\Plugin"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "refactor": "rector",
        "lint": "pint",
        "test:refactor": "rector --dry-run",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:refactor",
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
